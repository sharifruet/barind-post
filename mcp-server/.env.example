# Copy to mcp-server/.env (git-ignored). Real environment variables take precedence.

# The site's automation API. Use the final https URL — redirects are reported, not followed.
BARIND_API_URL=https://barindpost.com/api/v1
# Must equal automation.apiKey in the server's .env.
BARIND_API_KEY=dc997af96e1dfc036c4775c507c5185c65f514d7a9a943b2f79a807122a9443b
# BARIND_API_TIMEOUT_MS=30000

# Only for `npm run start:http` (other processes connect to http://HOST:PORT/mcp).
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3333
# Bearer token clients must send. Required if MCP_HTTP_HOST is not loopback.
# MCP_HTTP_TOKEN=
# With a non-loopback host: comma-separated Host header values to accept (DNS-rebinding protection).
# MCP_HTTP_ALLOWED_HOSTS=
