# Copy to .env.n8n (gitignored) and fill in real values, then:
#   docker compose -f docker-compose.n8n.yml up -d

GENERIC_TIMEZONE=Asia/Dhaka
TZ=Asia/Dhaka

# Required. Encrypts n8n's own credential store (separate from the CI4 app's
# encryption.key in .env). Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Recommended once this is reachable beyond localhost — protects the n8n editor UI
# itself (unrelated to the automation.apiKey the workflows use to call the CI4 API).
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=
# N8N_BASIC_AUTH_PASSWORD=

# Do NOT put the CI4 app's automation.apiKey or the AI provider's API key in this
# file — those belong in n8n's own credential store (Settings → Credentials) once
# the editor is running, not in plaintext on disk.
