#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://www.barindpost.com'
app.forceGlobalSecureRequests = true
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = your_database_name
database.default.username = your_database_user
database.default.password = your_database_password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# AUTOMATION (n8n) — see N8N_NEWS_AUTOMATION_PLAN.md
#--------------------------------------------------------------------
# Left commented out on purpose: the /api/v1 automation routes fail closed (reject
# every request) until both values below are set. Never commit real values here.

# automation.apiKey =
# automation.authorId =
# Optional defense-in-depth on top of the API key; empty/unset = unrestricted.
# automation.allowedIps =
#
# May the pipeline publish, or only file drafts? Off by default: with this unset, every
# article the automation creates waits in Admin -> Incoming for a human, whatever the
# caller asks for. Turning it on still does not publish everything — each article must
# also clear the gates in Api\NewsController::publishGateFailures() (long enough body,
# not a suspected cross-source duplicate, has a subtitle or key points, has a source URL);
# anything that fails is filed as a draft with the reasons in the response.
# automation.autoPublish = true
# automation.autoPublishMinWords = 120

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

encryption.key = your_32_character_random_string_here

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = '/absolute/path/to/your/writable/session'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 1
